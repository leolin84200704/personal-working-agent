{
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "/Users/hung.l/src/project-agent-factory/framework/hooks/validate-git-push.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git reset*)",
            "command": "/Users/hung.l/src/project-agent-factory/framework/hooks/validate-git-destructive.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git clean*)",
            "command": "/Users/hung.l/src/project-agent-factory/framework/hooks/validate-git-destructive.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "/Users/hung.l/src/project-agent-factory/framework/hooks/validate-repo-language.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hung.l/src/project-agent-factory/framework/hooks/protect-verification-assets.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
