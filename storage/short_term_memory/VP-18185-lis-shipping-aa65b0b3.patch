+      if (this.isUpstreamUnavailableError(e)) {
+        throw new HttpException(
+          {
+            code: HttpStatus.SERVICE_UNAVAILABLE,
+            message: `Sample lookup is temporarily unavailable: the upstream sample/EMR lookup service could not be reached. This is not confirmation that the sample is missing. Please retry shortly.`,
+          },
+          HttpStatus.SERVICE_UNAVAILABLE,
+        );
+      }
       throw new HttpException(
         {
           code: HttpStatus.NOT_FOUND,
@@ -13822,39 +13835,72 @@ export class OrdersService implements OnModuleInit {
     }
   }
 
+  /**
+   * VP-18185: is this error "the upstream gRPC service was unreachable" rather
+   * than "the upstream answered and had nothing"? Checks the grpc-js status
+   * code first; falls back to the message because our own wrappers (and
+   * async-retry) sometimes re-throw a plain Error and drop the code.
+   */
+  isUpstreamUnavailableError(e: any): boolean {
+    const code = e?.code ?? e?.cause?.code;
+    if (
+      code === GrpcStatus.UNAVAILABLE ||
+      code === GrpcStatus.DEADLINE_EXCEEDED
+    ) {
+      return true;
+    }
+    const msg = String(e?.message ?? '');
+    return /\bUNAVAILABLE\b|DEADLINE_EXCEEDED|No connection established|ECONNREFUSED|ETIMEDOUT/.test(
+      msg,
+    );
+  }
